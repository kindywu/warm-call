/* app.wxss — 暖心通话 · 全局设计令牌与基础样式 */

/* ===== 全局盒模型 ===== */
page, view, scroll-view, text, button, input, textarea, image, navigator, block, form, label, picker, switch, slider, radio, checkbox, icon, progress, rich-text, swiper, swiper-item, movable-view, movable-area, cover-view, cover-image, canvas, video, audio, ad, official-account, open-data, web-view, map, camera, live-player, live-pusher {
  box-sizing: border-box;
}

/* ===== 设计令牌（CSS 变量） ===== */
page {
  --bg: #f5f4ed;
  --surface: #faf9f5;
  --fg: #141413;
  --muted: #5e5d59;
  --meta: #87867f;
  --border: #f0eee6;
  --border-warm: #e8e6dc;
  --accent: #c96442;
  --accent-hover: #b0573a;
  --accent-soft: rgba(201, 100, 66, 0.14);
  --dark: #30302e;
  --danger: #b53333;
  --danger-soft: rgba(181, 51, 51, 0.12);
  --success: #17a34a;
  --success-soft: rgba(23, 163, 74, 0.12);
  --warn: #eab308;
  --blue: #3898ec;

  --font-display: Georgia, 'Times New Roman', serif;
  --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  --font-mono: Menlo, 'JetBrains Mono', ui-monospace, monospace;

  --radius: 10px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-sm: 8px;

  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

/* ===== 工具类 ===== */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }
.gap-8 { gap: 8px; }
.gap-10 { gap: 10px; }
.gap-12 { gap: 12px; }
.gap-16 { gap: 16px; }
.mt-8 { margin-top: 8px; }
.mt-12 { margin-top: 12px; }
.mt-16 { margin-top: 16px; }
.mb-8 { margin-bottom: 8px; }
.mb-12 { margin-bottom: 12px; }
.mb-16 { margin-bottom: 16px; }
.p-16 { padding: 16px; }
.p-20 { padding: 20px; }

/* 文字 */
.text-muted { color: var(--muted); }
.text-meta { color: var(--meta); }
.text-accent { color: var(--accent); }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-sm { font-size: 12px; }
.text-xs { font-size: 11px; }
.text-lg { font-size: 17px; }
.font-medium { font-weight: 500; }
.font-semibold { font-weight: 500; }
.font-display { font-family: var(--font-display); }
.font-mono { font-family: var(--font-mono); }

/* 按钮 */
.btn-primary {
  background: var(--accent);
  color: var(--surface);
  border: none;
  border-radius: var(--radius-md);
  padding: 10px 24px 10px 20px;
  font-size: 16px;
  font-weight: 500;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 0 0 1px var(--accent);
  transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
}
.btn-primary:active {
  background: var(--accent-hover);
  transform: scale(0.97);
  box-shadow: 0 0 0 1px var(--accent-hover);
}
.btn-primary[disabled] {
  opacity: 0.5;
  pointer-events: none;
}

.btn-ghost {
  background: var(--border-warm);
  color: var(--fg);
  border: none;
  border-radius: var(--radius);
  padding: 10px 20px;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
  box-shadow: 0 0 0 1px var(--border);
}
.btn-ghost:active { opacity: 0.8; }
.btn-ghost[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

.btn-outline {
  background: transparent;
  color: var(--muted);
  border: 1px solid var(--border-warm);
  border-radius: var(--radius);
  padding: 10px 20px;
  font-size: 14px;
}
.btn-outline:active {
  background: var(--bg);
  box-shadow: 0 0 0 1px var(--border-warm);
}

/* 卡片 */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  padding: 16px;
}

/* Chip 标签 */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  background: var(--accent-soft);
  color: var(--accent);
  border-radius: 999px;
  font-size: 12px;
  line-height: 1.4;
}
.chip-neutral {
  background: var(--border);
  color: var(--muted);
}
.chip-success {
  background: var(--success-soft);
  color: var(--success);
}
.chip-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

/* 分割线 */
.divider {
  height: 1px;
  background: var(--border);
  margin: 12px 0;
}

/* 安全区 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 空状态 */
.empty-state {
  padding: 48px 20px;
  text-align: center;
  color: var(--meta);
  font-size: 14px;
}

/* 脉冲动画 */
@keyframes pulse-call {
  0%, 100% { box-shadow: 0 0 0 0 rgba(201, 100, 66, 0.30); }
  50% { box-shadow: 0 0 0 10px rgba(201, 100, 66, 0); }
}

@keyframes pulse-priority {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.65; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes dotBounce {
  0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-4px); }
}
