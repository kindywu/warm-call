/* components/call-btn/call-btn.wxss — 脉冲拨号按钮样式 */

.call-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent);
  transition: transform 0.1s, background 0.15s;
  animation: pulse-call 2.4s ease-in-out infinite;
  flex-shrink: 0;
}

.call-btn:active {
  transform: scale(0.92);
  background: var(--accent-hover);
}

.call-btn.calling {
  animation: none;
  opacity: 0.6;
}

/* 普通尺寸 */
.call-btn--normal {
  width: 88rpx;
  height: 88rpx;
}

.call-btn--normal .call-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* 大尺寸（底部主按钮） */
.call-btn--large {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius);
}

.call-btn--large .call-icon {
  font-size: 40rpx;
  line-height: 1;
}
