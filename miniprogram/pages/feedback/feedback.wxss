/* pages/feedback/feedback.wxss — 通话反馈表单样式 */

.feedback-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  overflow-x: hidden;
  background: var(--bg);
}

/* 顶部导航 */
.top-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 20px 12px;
  background: var(--bg);
  flex-shrink: 0;
  border-bottom: 1px solid var(--border);
}

.back-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg);
  color: var(--muted);
}

.back-btn:active { background: var(--border-warm); }

.back-icon { font-size: 16px; line-height: 1; }

.top-bar-title {
  font-size: 17px;
  font-weight: 500;
  color: var(--fg);
  flex: 1;
  text-align: center;
}

/* 滚动区 */
.scroll-area {
  flex: 1;
  padding: 20px;
}

/* 老人信息 */
.elderly-info {
  padding: 16px;
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px solid var(--border-warm);
  margin-bottom: 16px;
}

.elderly-label {
  display: block;
  margin-bottom: 4px;
}

.elderly-name {
  font-size: 18px;
  color: var(--accent);
}

/* AI 状态 */
.ai-status {
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
  background: var(--surface);
}

.ai-done {
  background: var(--success-soft);
}

/* 表单 */
.form-group {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  margin-bottom: 8px;
  color: var(--fg);
}

.required {
  color: var(--danger);
}

.form-input {
  width: 100%;
  height: 46px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0 14px;
  font-size: 15px;
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--accent);
}

/* 时长选择器 */
.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: var(--muted);
  opacity: 0.5;
}

.picker-arrow {
  font-size: 12px;
  color: var(--muted);
  margin-left: 8px;
}

.form-textarea {
  width: 100%;
  min-height: 100px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-size: 15px;
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg);
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: var(--accent);
}

.form-hint {
  text-align: right;
  margin-top: 4px;
}

/* 心情选择 */
.mood-options {
  display: flex;
  gap: 10px;
}

.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 14px 8px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: border-color 0.15s, background 0.15s;
}

.mood-item.active {
  border-color: var(--accent);
  background: rgba(201, 100, 66, 0.08);
}

.mood-emoji {
  font-size: 28px;
  line-height: 1;
}

.mood-text {
  color: var(--muted);
}

.mood-item.active .mood-text {
  color: var(--accent);
}

/* 标签多选 */
.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag-item {
  padding: 8px 16px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 999px;
  font-size: 13px;
  color: var(--muted);
  transition: all 0.15s;
}

.tag-item.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #faf9f5;
}

/* 建议话题输入 */
.suggestion-inputs {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sug-input-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.sug-input-num {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--accent);
  color: #faf9f5;
  font-size: 11px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sug-input {
  flex: 1;
}

/* 底部按钮 */
.bottom-bar {
  display: flex;
  gap: 12px;
  padding: 12px 20px;
  background: var(--bg);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}

.btn-cancel {
  flex-shrink: 0;
  width: 80px;
  height: 48px;
  border-radius: var(--radius);
  background: var(--bg);
  color: var(--muted);
  font-size: 15px;
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel:active { background: var(--border-warm); }

.btn-submit {
  flex: 1;
  height: 48px;
  border-radius: var(--radius);
  background: var(--accent);
  color: #faf9f5;
  font-size: 16px;
  font-weight: 500;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-submit:active { background: var(--accent-hover); }
.btn-submit[disabled] { opacity: 0.5; pointer-events: none; }
