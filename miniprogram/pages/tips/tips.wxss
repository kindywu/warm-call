/* pages/tips/tips.wxss — 沟通技巧页（只读·Q&A折叠） */

.tips-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  overflow-x: hidden;
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px 20px;
  background: var(--bg);
  flex-shrink: 0;
}

.header-back {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  color: var(--fg);
  border-radius: 50%;
  background: var(--border-warm);
}
.header-back:active { background: var(--border); }

.header-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 500;
  color: var(--fg);
  line-height: 1.20;
}

.header-spacer { width: 36px; }

/* ===== 搜索 ===== */
.search-wrap {
  padding: 0 20px 16px;
  flex-shrink: 0;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 44px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 14px;
}

.search-icon {
  font-size: 15px;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 15px;
  color: var(--fg);
  background: transparent;
}

.search-clear {
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--border-warm);
  font-size: 12px;
  color: var(--muted);
  flex-shrink: 0;
}

/* ===== 卡片列表 ===== */
.content-area {
  flex: 1;
  padding: 0 20px;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ===== Q&A 卡片 ===== */
.qa-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: 0 0 0 0 transparent;
  transition: box-shadow 0.2s ease;
  overflow: hidden;
}

.qa-card:active {
  box-shadow: 0 0 0 1px var(--border-warm);
}

/* 问题标题行 */
.qa-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  cursor: pointer;
}

.qa-number {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--accent-soft);
  flex-shrink: 0;
  margin-top: 1px;
}

.qa-number text {
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 500;
  color: var(--accent);
  line-height: 1;
}

.qa-body {
  flex: 1;
  min-width: 0;
}

.qa-question {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 500;
  color: var(--fg);
  line-height: 1.30;
  display: block;
}

.qa-chevron {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.qa-chevron text {
  font-size: 20px;
  color: var(--muted);
  line-height: 1;
}

.qa-chevron.open {
  transform: rotate(90deg);
}

/* ===== 解释区（折叠动画） ===== */
.qa-explanation-wrap {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.35s ease;
}

.qa-explanation-wrap.expanded {
  grid-template-rows: 1fr;
}

.qa-explanation-inner {
  overflow: hidden;
}

.qa-divider {
  height: 1px;
  background: var(--border);
  margin: 0 16px;
}

.qa-answer {
  display: block;
  padding: 14px 16px 18px;
  font-size: 15px;
  color: var(--muted);
  line-height: 1.60;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96px 20px;
  text-align: center;
}

.empty-icon {
  font-size: 40px;
  margin-bottom: 20px;
  opacity: 0.6;
}

.empty-title {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 500;
  color: var(--muted);
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: var(--meta);
  line-height: 1.60;
  max-width: 260px;
}
